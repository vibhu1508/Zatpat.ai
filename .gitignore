# =============================================================================
# Zatpat.ai .gitignore — Production Backend Distribution
# =============================================================================

# Virtual Environment & Python Cache
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Large Data & Datasets (loaded/indexed at runtime)
data/
*.parquet
*.jsonl
msmarco_xi_preview.json

# Test suites & Local test scripts (Pure backend only)
backend/tests/
test_cli.py
voice_client.py
benchmark.py
frontend/

# Logs & Benchmark Artifacts
*.log
benchmark_results.json
implementation_plan.md
.pytest_cache/
.coverage
htmlcov/

# Operating System & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
